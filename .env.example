# --- Frontend (inyectado en tiempo de ejecución por 40-runtime-config.sh) ---
VITE_API_URL=http://localhost:8080/api
VITE_FIREBASE_API_KEY=REEMPLAZAR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=ecoredmicroservicios-670df.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecoredmicroservicios-670df
VITE_FIREBASE_APP_ID=REEMPLAZAR_APP_ID

# --- API Gateway ---
FIREBASE_PROJECT_ID=ecoredmicroservicios-670df
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Companies Service (Django + MongoDB) ---
DJANGO_SECRET_KEY=REEMPLAZAR_CLAVE_SEGURA
DJANGO_DEBUG=False
COMPANIES_MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/ecored_companies?retryWrites=true&w=majority
COMPANIES_MONGODB_DB_NAME=ecored_companies

# --- Materials Service (Node.js + Oracle) ---
ORACLE_USER=ECORED
ORACLE_PASSWORD=REEMPLAZAR_PASSWORD_ORACLE
ORACLE_CONNECT_STRING=REEMPLAZAR_CONNECT_STRING_TLS

# --- Requests Service (Node.js + MongoDB propio en Docker) ---
REQUESTS_MONGO_USER=ecored_requests_user
REQUESTS_MONGO_PASSWORD=REEMPLAZAR_PASSWORD_ALFANUMERICA
REQUESTS_MONGO_DB_NAME=ecored_requests